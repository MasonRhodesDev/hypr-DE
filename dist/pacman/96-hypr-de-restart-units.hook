[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/hypr-de/hypr/hypridle.conf
Target = usr/lib/systemd/user/hypridle.service.d/*
Target = usr/lib/hypr-de/hypridle-launch

[Action]
Description = Restarting session units onto the new config...
When = PostTransaction
Exec = @LIBEXECDIR@/hypr-de-restart-session-units
