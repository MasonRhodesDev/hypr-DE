export LIBSEAT_BACKEND=logind

# uwsm waits for WAYLAND_DISPLAY and HYPRLAND_INSTANCE_SIGNATURE, and main.lua
# exports them with the rest of the session's variables in one call, so the
# default 0.2 s settle after they appear only delays graphical-session.target
# and the boot scene's release.
export UWSM_WAIT_VARNAMES_SETTLETIME="${UWSM_WAIT_VARNAMES_SETTLETIME:-0}"

# Hyprland would tell uwsm it is ready before it has exported anything. With
# this off, main.lua says so right after its one export, and hypr-DE's
# wayland-session-waitenv.service drop-in can skip uwsm's 0.5 s poll.
export HYPRLAND_NO_SD_NOTIFY="${HYPRLAND_NO_SD_NOTIFY:-1}"

if [ -d /sys/module/nvidia ]; then
    export LIBVA_DRIVER_NAME=nvidia
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export NVD_BACKEND=direct
fi

_gpu_sel=/usr/bin/hyprstate
if [ -x "$_gpu_sel" ]; then
    _aq=$("$_gpu_sel" gpu select 2>/dev/null) || _aq=""
    case "$_aq" in *[!/:.A-Za-z0-9_-]*) _aq="" ;; esac
    case "$_aq" in
        /dev/dri/card*) export AQ_DRM_DEVICES="$_aq" ;;
    esac
fi
unset _gpu_sel _aq