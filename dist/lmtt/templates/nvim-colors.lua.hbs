-- hypr-DE Neovim colors — rendered by lmtt. Mode: {{mode}}
-- Sourced from /etc/xdg/nvim/sysinit.vim; your ~/.config/nvim wins.
local set = vim.api.nvim_set_hl
vim.o.background = "{{mode}}"
vim.g.colors_name = "lmtt-material-you"

-- editor chrome
set(0, "Normal",        { fg = "{{on_surface}}", bg = "{{surface}}" })
set(0, "NormalFloat",   { fg = "{{on_surface}}", bg = "{{surface_container}}" })
set(0, "FloatBorder",   { fg = "{{outline}}", bg = "{{surface_container}}" })
set(0, "FloatTitle",    { fg = "{{primary}}", bold = true })
set(0, "ColorColumn",   { bg = "{{surface_container}}" })
set(0, "Cursor",        { fg = "{{surface}}", bg = "{{primary}}" })
set(0, "CursorLine",    { bg = "{{surface_container}}" })
set(0, "CursorLineNr",  { fg = "{{primary}}", bold = true })
set(0, "LineNr",        { fg = "{{outline}}" })
set(0, "SignColumn",    { bg = "{{surface}}" })
set(0, "Visual",        { bg = "{{surface_container_high}}" })
set(0, "VertSplit",     { fg = "{{outline_variant}}" })
set(0, "WinSeparator",  { fg = "{{outline_variant}}" })
set(0, "Folded",        { fg = "{{on_surface_variant}}", bg = "{{surface_container}}" })
set(0, "MatchParen",    { fg = "{{primary}}", bold = true })
set(0, "Pmenu",         { fg = "{{on_surface}}", bg = "{{surface_container_high}}" })
set(0, "PmenuSel",      { fg = "{{on_primary_container}}", bg = "{{primary_container}}" })
set(0, "PmenuSbar",     { bg = "{{surface_container_high}}" })
set(0, "PmenuThumb",    { bg = "{{outline}}" })
set(0, "StatusLine",    { fg = "{{on_surface}}", bg = "{{surface_container_high}}" })
set(0, "StatusLineNC",  { fg = "{{on_surface_variant}}", bg = "{{surface_container}}" })
set(0, "TabLineSel",    { fg = "{{on_primary_container}}", bg = "{{primary_container}}" })
set(0, "TabLine",       { fg = "{{on_surface_variant}}", bg = "{{surface_container}}" })
set(0, "Search",        { fg = "{{surface}}", bg = "{{secondary}}" })
set(0, "IncSearch",     { fg = "{{surface}}", bg = "{{primary}}" })
set(0, "Title",         { fg = "{{primary}}", bold = true })
set(0, "NonText",       { fg = "{{outline_variant}}" })
