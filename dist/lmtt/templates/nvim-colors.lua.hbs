-- syntax
set(0, "Comment",       { fg = "{{outline}}", italic = true })
set(0, "Constant",      { fg = "{{tertiary}}" })
set(0, "String",        { fg = "{{secondary}}" })
set(0, "Character",     { fg = "{{secondary}}" })
set(0, "Number",        { fg = "{{tertiary}}" })
set(0, "Boolean",       { fg = "{{tertiary}}" })
set(0, "Identifier",    { fg = "{{on_surface}}" })
set(0, "Function",      { fg = "{{primary}}" })
set(0, "Statement",     { fg = "{{primary}}", bold = true })
set(0, "Keyword",       { fg = "{{primary}}", bold = true })
set(0, "Operator",      { fg = "{{on_surface_variant}}" })
set(0, "PreProc",       { fg = "{{tertiary}}" })
set(0, "Type",          { fg = "{{secondary}}" })
set(0, "Special",       { fg = "{{tertiary}}" })
set(0, "Underlined",    { fg = "{{primary}}", underline = true })
set(0, "Error",         { fg = "{{error}}", bold = true })
set(0, "Todo",          { fg = "{{surface}}", bg = "{{tertiary}}", bold = true })
