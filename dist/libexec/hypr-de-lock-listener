#!/usr/bin/python3 -I
import os
import sys

from gi.repository import Gio, GLib

LOCK_CMD = "@LIBEXECDIR@/lock-cmd.sh"
LOGIND = "org.freedesktop.login1"
MANAGER_PATH = "/org/freedesktop/login1"
MANAGER = "org.freedesktop.login1.Manager"
SESSION = "org.freedesktop.login1.Session"


def log(message):
    print(f"hypr-de-lock-listener: {message}", file=sys.stderr, flush=True)


def call(bus, path, interface, method, signature, args, reply):
    return bus.call_sync(
        LOGIND, path, interface, method,
        GLib.Variant(signature, args), GLib.VariantType(reply),
        Gio.DBusCallFlags.NONE, -1, None,
    ).unpack()


def own_session(bus):
    session_id = os.environ.get("XDG_SESSION_ID")
    if session_id:
        (path,) = call(bus, MANAGER_PATH, MANAGER, "GetSession", "(s)", (session_id,), "(o)")
        return session_id, path
    (user,) = call(bus, MANAGER_PATH, MANAGER, "GetUser", "(u)", (os.getuid(),), "(o)")
    ((session_id, path),) = call(
        bus, user, "org.freedesktop.DBus.Properties", "Get", "(ss)",
        ("org.freedesktop.login1.User", "Display"), "(v)",
    )
    if not session_id:
        raise RuntimeError(f"user {os.getuid()} has no graphical session")
    return session_id, path


class Locker:
    def __init__(self, session_id):
        self.launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.NONE)
        self.launcher.setenv("XDG_SESSION_ID", session_id, True)
        self.running = False
        self.waiters = []

    def request(self, *args, then=None):
        if then:
            self.waiters.append(then)
        if self.running:
            log("a lock is already starting; not starting another")
            return
        try:
            child = self.launcher.spawnv([LOCK_CMD, *args])
        except GLib.Error as error:
            log(f"cannot run {LOCK_CMD}: {error.message}")
            self.notify_waiters()
            return
        self.running = True
        child.wait_async(None, self.finished)

    def finished(self, child, result):
        child.wait_finish(result)
        self.running = False
        if not child.get_successful():
            log(f"{LOCK_CMD} failed with status {child.get_status()}")
        self.notify_waiters()

    def notify_waiters(self):
        waiters, self.waiters = self.waiters, []
        for waiter in waiters:
            waiter()


class SleepDelay:
    def __init__(self, bus):
        self.bus = bus
        self.fd = None
        self.sleeping = False

    def take(self):
        if self.fd is not None:
            return
        try:
            reply, fds = self.bus.call_with_unix_fd_list_sync(
                LOGIND, MANAGER_PATH, MANAGER, "Inhibit",
                GLib.Variant("(ssss)", ("sleep", "hypr-de", "Lock the screen before sleep", "delay")),
                GLib.VariantType("(h)"), Gio.DBusCallFlags.NONE, -1, None, None,
            )
            held = fds.steal_fds()
            (index,) = reply.unpack()
            self.fd = held.pop(index)
            for extra in held:
                os.close(extra)
        except GLib.Error as error:
            log(f"no sleep delay from logind, so sleep may not wait for the lock: {error.message}")

    def release(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def going_down(self):
        self.sleeping = True

    def resumed(self):
        self.sleeping = False
        self.take()

    def lock_returned(self):
        self.release()
        if not self.sleeping:
            self.take()


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    try:
        session_id, path = own_session(bus)
    except (GLib.Error, RuntimeError) as error:
        log(f"cannot find this user's session: {getattr(error, 'message', error)}")
        return 1
    locker = Locker(session_id)
    delay = SleepDelay(bus)

    def prepare_for_sleep(_bus, _sender, _path, _iface, _member, params):
        (going_down,) = params.unpack()
        if going_down:
            delay.going_down()
            locker.request("--sleep", then=delay.lock_returned)
        else:
            delay.resumed()

    bus.signal_subscribe(
        LOGIND, SESSION, "Lock", path, None, Gio.DBusSignalFlags.NONE,
        lambda *_: locker.request(),
    )
    bus.signal_subscribe(
        LOGIND, MANAGER, "PrepareForSleep", MANAGER_PATH, None, Gio.DBusSignalFlags.NONE,
        prepare_for_sleep,
    )
    delay.take()
    log(f"locking session {session_id} on each logind Lock request and before sleep")
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
