#!/bin/bash
# One-time first-login greeting, invoked from main.lua's hyprland.start hook.
# --adopt: pre-seed the marker so migrating users get no retro-greeting
# (called by hypr-de-setup --adopt).
set -u

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
MARKER="$CONFIG/hypr-de/welcome-shown-1"

if [ "${1:-}" = "--adopt" ]; then
    mkdir -p "$CONFIG/hypr-de"
    touch "$MARKER"
    exit 0
fi

[ -e "$MARKER" ] && exit 0
mkdir -p "$CONFIG/hypr-de"
touch "$MARKER"   # once-ever, regardless of how the window ends

exec @BINDIR@/hypr-de-help --welcome
