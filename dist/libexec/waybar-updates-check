#!/bin/bash
# waybar updates module backend: counts pending updates, or runs the upgrade
# in a terminal. Detects the package manager at runtime so one packaged config
# serves Fedora and Arch.
set -u

TERM_CMD="${TERMINAL:-kitty}"

# Emits waybar JSON: {"text": N, "class": "de-update"?, "tooltip": ...}.
# The class highlights the module (see lmtt waybar template) when hypr-de
# itself is among the pending updates.
count() {
    local out n cls="" tip
    if command -v dnf >/dev/null 2>&1; then
        out=$(timeout 30 dnf list --upgradable 2>/dev/null | tail -n +2)
    elif command -v yay >/dev/null 2>&1; then
        out=$(timeout 30 yay -Qu 2>/dev/null)
    elif command -v checkupdates >/dev/null 2>&1; then
        out=$(timeout 30 checkupdates 2>/dev/null)
    else
        out=""
    fi
    n=$(printf '%s' "$out" | grep -c .)
    tip="$n updates pending"
    # hypr-de.noarch (dnf) / "hypr-de " (arch); also matches hypr-de-gaming
    if printf '%s\n' "$out" | grep -q '^hypr-de'; then
        cls="de-update"
        tip="hypr-DE update available — $tip"
    fi
    jq -cn --arg text "$n" --arg class "$cls" --arg tooltip "$tip" \
        '{text: $text, class: $class, tooltip: $tooltip}'
}

upgrade() {
    if command -v dnf >/dev/null 2>&1; then
        exec "$TERM_CMD" sh -c 'sudo dnf upgrade; echo "Done - Press enter to exit"; read'
    elif command -v yay >/dev/null 2>&1; then
        exec "$TERM_CMD" sh -c 'yay -Syu; echo "Done - Press enter to exit"; read'
    else
        exec "$TERM_CMD" sh -c 'sudo pacman -Syu; echo "Done - Press enter to exit"; read'
    fi
}

case "${1:-count}" in
    count)   count ;;
    upgrade) upgrade ;;
    *) echo "usage: $0 {count|upgrade}" >&2; exit 2 ;;
esac
