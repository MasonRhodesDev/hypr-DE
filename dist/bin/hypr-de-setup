#!/bin/bash
# hypr-DE per-user setup. Idempotent. Package-owned defaults live under
# /usr and /etc/xdg; this script does not copy them into home.
#
# It:
#   - presets DE user units (Arch and existing Fedora users; new Fedora
#     accounts get the preset via %systemd_user_post)
#   - verifies those units are enabled (fail closed)
#   - copies xdph.conf into ~/.config/hypr/ if missing (XDPH only reads
#     that path; it does not search XDG_CONFIG_DIRS)
#
# --adopt: back up and remove ~/.config/hypr/hyprland.lua so Hyprland uses
# the packaged /etc/xdg/hypr/hyprland.lua. Overrides belong in local.lua.
set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
DATADIR="@DATADIR@"
ADOPT=0
[ "${1:-}" = "--adopt" ] && ADOPT=1

say() { printf '== %s\n' "$*"; }
warn() { printf '!! %s\n' "$*" >&2; }

REQUIRED_UNITS=(
    sni-watcher.service
    hypridle.service
    hyprpolkitagent.service
    swaync.service
    waybar.service
    swaybg.service
    waybar-reload.path
    waybar-watchdog.timer
    wayland-env-guard.path
    wayland-env-guard.timer
    hyprland-configreload-listener.service
    notification-focus-proxy.service
    hypr-de-prime-theme.service
    udiskie.service
    hyprstate.service
    logind-idle-control.service
    voice-dictation.service
    obex.service
)

GAMING_UNITS=(
    bp-game-focus.service
    steam-clean-shutdown.service
)

user_systemd_ok() {
    systemctl --user show-environment >/dev/null 2>&1
}

unit_exists() {
    systemctl --user cat "$1" >/dev/null 2>&1
}

unit_enabled() {
    case "$(systemctl --user is-enabled "$1" 2>/dev/null || echo missing)" in
        enabled|enabled-runtime|static|alias|indirect) return 0 ;;
        *) return 1 ;;
    esac
}

preset_and_check() {
    local fail=0 u
    systemctl --user daemon-reload || true
    for u in "$@"; do
        if ! unit_exists "$u"; then
            warn "missing unit file: $u"
            fail=1
            continue
        fi
        if ! systemctl --user preset "$u" >/dev/null 2>&1; then
            warn "preset failed: $u"
            fail=1
            continue
        fi
        if ! unit_enabled "$u"; then
            warn "$u is $(systemctl --user is-enabled "$u" 2>/dev/null || echo missing) (expected enabled)"
            fail=1
        fi
    done
    return "$fail"
}

nvidia_notice() {
    local hw=0 v
    for v in /sys/bus/pci/devices/*/vendor; do
        [ -f "$v" ] || continue
        if [ "$(cat "$v" 2>/dev/null)" = "0x10de" ]; then
            hw=1
            break
        fi
    done
    [ "$hw" = 1 ] || return 0
    if [ -d /sys/module/nvidia ]; then
        say "NVIDIA GPU + proprietary module detected; uwsm env-hyprland will apply wiki session vars"
    else
        say "NVIDIA GPU detected, proprietary module not loaded (not a hypr-DE dep)"
        say "Arch: nvidia-dkms nvidia-utils libva-nvidia-driver — Fedora: akmod-nvidia"
    fi
}

# Screen-share portal config: XDPH hardcodes ~/.config/hypr/xdph.conf.
if [ ! -e "$CONFIG/hypr/xdph.conf" ]; then
    mkdir -p "$CONFIG/hypr"
    cp "$DATADIR/hypr/xdph.conf" "$CONFIG/hypr/xdph.conf"
    say "xdph.conf seeded (XDPH has no system config path)"
fi

# Icon theme: adwaita-icon-theme no longer ships app icons, so the gsettings
# default renders blank icons in fuzzel/swaync/GTK apps. Seed Papirus once
# (lmtt's gtk module then flips Papirus/Papirus-Dark per mode); never touch a
# theme the user picked themselves.
if command -v gsettings >/dev/null 2>&1 && [ -d /usr/share/icons/Papirus ]; then
    current_icons=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'" || echo "")
    case "$current_icons" in
        ""|Adwaita|hicolor)
            if gsettings set org.gnome.desktop.interface icon-theme Papirus 2>/dev/null; then
                say "icon theme seeded to Papirus (was ${current_icons:-unset})"
            fi
            ;;
    esac
fi

if [ "$ADOPT" = 1 ] && [ -e "$CONFIG/hypr/hyprland.lua" ]; then
    BK="$CONFIG/hypr-de/backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$BK"
    cp -a "$CONFIG/hypr/hyprland.lua" "$BK/hyprland.lua"
    rm -f "$CONFIG/hypr/hyprland.lua"
    say "hyprland.lua moved to $BK/hyprland.lua (Hyprland will use /etc/xdg/hypr/hyprland.lua)"
    "@LIBEXECDIR@/hypr-de-welcome" --adopt
fi

if ! user_systemd_ok; then
    warn "no systemd user session (need DBUS/XDG_RUNTIME_DIR). Re-run hypr-de-setup after login."
    exit 1
fi

units=("${REQUIRED_UNITS[@]}")
for u in "${GAMING_UNITS[@]}"; do
    unit_exists "$u" && units+=("$u")
done

if preset_and_check "${units[@]}"; then
    say "DE user units preset and enabled"
else
    warn "one or more DE user units failed to enable"
    exit 1
fi

if ! command -v sni-watcher >/dev/null 2>&1; then
    warn "sni-watcher missing — Waybar may claim org.kde.StatusNotifierWatcher"
    exit 1
fi

nvidia_notice

if [ ! -e /usr/lib/hyprland/plugins/libworkspace-zones.so ] \
    && [ ! -e /usr/lib64/hyprland/plugins/libworkspace-zones.so ] \
    && [ ! -e "$HOME/.local/lib/hyprland-plugins/libworkspace-zones.so" ]; then
    warn "workspace-zones plugin missing; SUPER+ALT+S is a no-op until:"
    warn "  hyprpm add https://github.com/MasonRhodesDev/waybar-workspace-buttons"
    warn "  hyprpm enable workspace-zones"
fi

say "hypr-DE setup complete. Log into Hyprland (uwsm) from the greeter."
