#!/bin/bash
# hypr-DE per-user setup. Idempotent: seeds the minimal user-side files the
# packaged DE needs, enables the DE user units, and primes the themed styles.
# Everything else is package-owned — this script deliberately seeds only:
#   ~/.config/hypr/hyprland.lua          (3-line entry stub, stable forever)
#   ~/.config/hypr-de/wallpaper.conf     ($WALLPAPER, default fallback)
#   ~/.config/hypr/profiles/             (empty dir; hyprstate fills it)
#
# --adopt: overwrite an existing hyprland.lua with the stub, backing the old
# file up to ~/.config/hypr-de/backup-<date>/.
set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
DATADIR="@DATADIR@"
ADOPT=0
[ "${1:-}" = "--adopt" ] && ADOPT=1

say() { printf '== %s\n' "$*"; }

mkdir -p "$CONFIG/hypr/profiles" "$CONFIG/hypr-de"

# Entry stub
STUB_SRC="$DATADIR/hypr/hyprland.lua.stub"
STUB_DST="$CONFIG/hypr/hyprland.lua"
if [ -e "$STUB_DST" ] && ! cmp -s "$STUB_SRC" "$STUB_DST"; then
    if [ "$ADOPT" = 1 ]; then
        BK="$CONFIG/hypr-de/backup-$(date +%Y%m%d-%H%M%S)"
        mkdir -p "$BK"
        cp -a "$STUB_DST" "$BK/hyprland.lua"
        cp "$STUB_SRC" "$STUB_DST"
        say "hyprland.lua replaced with stub (old file: $BK/hyprland.lua)"
        # Migrating an existing config: skip the first-login greeting
        "@LIBEXECDIR@/hypr-de-welcome" --adopt
    else
        say "hyprland.lua exists and differs from the stub — leaving it alone (use --adopt to replace with backup)"
    fi
else
    cp "$STUB_SRC" "$STUB_DST"
    say "hyprland.lua stub in place"
fi

# Screen-share portal config: xdph only reads ~/.config/hypr/xdph.conf and
# hyprlang `source=` support there is unverified, so seed a copy (not a stub).
if [ ! -e "$CONFIG/hypr/xdph.conf" ]; then
    cp "$DATADIR/hypr/xdph.conf" "$CONFIG/hypr/xdph.conf"
    say "xdph.conf seeded"
fi

# Wallpaper: swaybg/lmtt must agree, and set-wallpaper is the single writer.
# Align when the wallpaper file is missing OR lmtt's configured wallpaper
# doesn't resolve (fresh lmtt defaults to a nonexistent path, silently
# falling back to the built-in palette).
CUR_WP=$(sed -n 's/^\$WALLPAPER = //p' "$CONFIG/hypr-de/wallpaper.conf" 2>/dev/null)
[ -n "$CUR_WP" ] && [ -r "$CUR_WP" ] || CUR_WP="$DATADIR/wallpapers/default.png"
LMTT_WP=$(lmtt status 2>/dev/null | sed -n 's/^Wallpaper: //p'); LMTT_WP="${LMTT_WP/#\~/$HOME}"
if [ ! -e "$CONFIG/hypr-de/wallpaper.conf" ] || [ ! -r "$LMTT_WP" ]; then
    "@BINDIR@/hypr-de-set-wallpaper" "$CUR_WP" >/dev/null
    say "wallpaper aligned across swaybg/lmtt ($CUR_WP)"
fi

# DE user units (covers Arch and pre-existing users; preset files handle new
# Fedora users via %systemd_user_post)
if systemctl --user is-enabled default.target >/dev/null 2>&1 || [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    systemctl --user daemon-reload || true
    systemctl --user preset \
        sni-watcher.service \
        hypridle.service hyprpolkitagent.service swaync.service waybar.service \
        swaybg.service waybar-reload.path waybar-watchdog.timer \
        wayland-env-guard.path wayland-env-guard.timer \
        hyprland-configreload-listener.service notification-focus-proxy.service \
        udiskie.service \
        hyprstate.service logind-idle-control.service voice-dictation.service \
        bp-game-focus.service steam-clean-shutdown.service \
        2>/dev/null || true
    say "DE user units preset"
fi

if ! command -v sni-watcher >/dev/null 2>&1; then
    say "sni-watcher missing — Waybar may claim org.kde.StatusNotifierWatcher"
fi

# Bootstrap the rendered stylesheets waybar/swaync launch against. The
# packaged .hbs templates are valid CSS (handlebars tokens only appear in
# comments), so a plain copy keeps first launch styled even before lmtt
# (with system-module support) has rendered them properly. lmtt overwrites
# these on the next `lmtt switch`.
for t in waybar swaync; do
    if [ ! -e "$CONFIG/hypr-de/$t.css" ]; then
        cp "$DATADIR/lmtt/templates/$t.css.hbs" "$CONFIG/hypr-de/$t.css"
        say "$t.css bootstrapped from template"
    fi
done

# Prime themed styles so first launch isn't unstyled
if command -v lmtt >/dev/null 2>&1; then
    lmtt switch dark >/dev/null 2>&1 || true
    say "lmtt theme primed"
fi

say "hypr-DE setup complete. Log into the hypr-DE session (or hyprctl reload)."
