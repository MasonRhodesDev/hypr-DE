#!/bin/bash
# Set the hypr-DE wallpaper. Single owner of all three wallpaper consumers:
#   ~/.config/hypr-de/wallpaper.conf          ($WALLPAPER for hyprlock)
#   ~/.config/environment.d/wallpaper.conf    (WALLPAPER_PATH for swaybg.service)
#   ~/.config/appearance-profiles/default.toml   (shared wallpaper registry)
# then applies live (systemd user env + swaybg restart + lmtt re-render).
set -euo pipefail

usage() { echo "usage: hypr-de-set-wallpaper <image-path>" >&2; exit 2; }
[ $# -eq 1 ] || usage

WP=$(readlink -f "$1")
[ -r "$WP" ] || { echo "hypr-de-set-wallpaper: cannot read $WP" >&2; exit 1; }

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CONFIG/hypr-de" "$CONFIG/environment.d"

printf '$WALLPAPER = %s\n' "$WP" > "$CONFIG/hypr-de/wallpaper.conf"
printf 'WALLPAPER_PATH=%s\n' "$WP" > "$CONFIG/environment.d/wallpaper.conf"

# LMTT implements the appearance-profiles standard and publishes a
# greeter-readable copy for Vigil. Keep the old config writer only as a
# transition fallback when an older lmtt is installed.
if command -v lmtt >/dev/null 2>&1 && lmtt wallpaper set "$WP"; then
    :
else
    LMTT_CFG="$CONFIG/lmtt/config.toml"
    mkdir -p "$CONFIG/lmtt"
    if [ ! -e "$LMTT_CFG" ]; then
        printf '[general]\nwallpaper = "%s"\n' "$WP" > "$LMTT_CFG"
    else
        TMP=$(mktemp "$LMTT_CFG.XXXXXX")
        awk -v wp="$WP" '
            function emit() { print "wallpaper = \"" wp "\""; done = 1 }
            /^\[general\]/ { ingen = 1; print; next }
            /^\[/          { if (ingen && !done) emit(); ingen = 0; print; next }
            ingen && !done && /^[[:space:]]*wallpaper[[:space:]]*=/ { emit(); next }
            { print }
            END { if (!done) { if (!ingen) print "[general]"; emit() } }
        ' "$LMTT_CFG" > "$TMP" && mv "$TMP" "$LMTT_CFG"
    fi
fi

if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    # No set-environment. swaybg-launch reads the registry written above, so
    # the environment is not consulted - and an override here would outrank
    # environment.d forever, which is how the desktop and the lock screen
    # came to show different wallpapers for eight days. The environment.d
    # file stays for anything of the user's own that still reads it.
    systemctl --user try-restart swaybg.service 2>/dev/null || true
    # Re-render the theme from the new wallpaper in the CURRENT mode.
    # NEVER bare `lmtt switch` — that toggles light/dark.
    if command -v lmtt >/dev/null 2>&1; then
        MODE=$(lmtt status 2>/dev/null | sed -n 's/^Current theme: //p')
        case "$MODE" in light|dark) ;; *) MODE=dark ;; esac
        # First-boot setup has a user bus but no compositor; notify-send
        # would stall waiting for a notification daemon that is not up.
        if [ -n "${WAYLAND_DISPLAY:-}" ]; then
            lmtt switch "$MODE" >/dev/null 2>&1 || true
        else
            lmtt switch --no-notify "$MODE" >/dev/null 2>&1 || true
        fi
    fi
fi

echo "Wallpaper set: $WP (palette re-rendered; lockscreen picks it up on next lock)"
