#!/bin/bash
# Freeze-first screenshot with swappy annotation.
# hyprpicker freezes every output ~10ms after keypress, locking in the
# pixels; slurp picks a region over the frozen overlay and grim then
# captures that region from the overlay itself, so nothing that happens
# during selection (dialogs closing, overlay fade-outs) can leak into the
# shot. Trade-off vs the old capture-first pipeline: hyprpicker bakes the
# mouse cursor into its frozen image, so shots include the cursor at its
# keypress position.

FREEZE_PID=""
SHOT=$(mktemp --suffix=.png)
cleanup() {
    [ -n "$FREEZE_PID" ] && kill "$FREEZE_PID" 2>/dev/null
    rm -f "$SHOT"
}
trap cleanup EXIT

hyprpicker -r -z &
FREEZE_PID=$!

# Give the freeze overlay a beat to map so slurp stacks above it
sleep 0.02

SELECTION=$(slurp -d 2>/dev/null)
SLURP_EXIT=$?
[ $SLURP_EXIT -ne 0 ] && exit 1
[ -z "$SELECTION" ] && exit 1

# Wait for slurp's dim overlay to leave the scene before capturing
for _ in $(seq 1 50); do
    hyprctl layers | grep -q "namespace: selection" || break
done

# Seed swappy's config on first use only. This used to be rewritten on every
# single screenshot, silently discarding whatever the user had set. The
# packaged copy is the same content and is the one source of truth for it.
SWAPPY_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/swappy/config"
if [ ! -e "$SWAPPY_CFG" ]; then
    mkdir -p "$(dirname "$SWAPPY_CFG")"
    if [ -r "@DATADIR@/swappy/config" ]; then
        cp "@DATADIR@/swappy/config" "$SWAPPY_CFG"
    fi
fi

# Capture from the frozen overlay, then unfreeze before swappy opens so
# it isn't buried under (and its first click eaten by) hyprpicker
grim -g "$SELECTION" "$SHOT" || exit 1
kill "$FREEZE_PID" 2>/dev/null
FREEZE_PID=""

swappy -f "$SHOT"

echo "💡 Swappy shortcuts: Ctrl+C (copy & quit), Ctrl+S (save), Escape (manual quit)"
