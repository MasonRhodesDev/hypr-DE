[Unit]
Description=Lock the session whenever logind asks (loginctl lock-session, lid close)
PartOf=graphical-session.target
After=graphical-session.target
# A lock listener that systemd gives up on leaves Lock unanswered, so never stop restarting it.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@LIBEXECDIR@/hypr-de-lock-listener
# Outside Hyprland the listener logs why and exits 0; only a failure is restarted.
Restart=on-failure
RestartSec=1
# lock-cmd.sh's last-resort retry runs vigil-lock bare, in this cgroup; a restart must not kill a held lock.
KillMode=process
SyslogIdentifier=hypr-de-lock
