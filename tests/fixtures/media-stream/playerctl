#!/bin/bash
printf '%s\n' "$*" >> "$MEDIA_ARGV_LOG"
echo $$ > "$MEDIA_PIDFILE"
if [ -n "${MEDIA_SCRIPT:-}" ] && [ -f "$MEDIA_SCRIPT" ]; then
    while IFS= read -r line; do
        printf '%b\n' "$line"
        sleep 0.05
    done < "$MEDIA_SCRIPT"
fi
if [ -n "${MEDIA_EXIT:-}" ]; then
    exit "$MEDIA_EXIT"
fi
sleep 30
