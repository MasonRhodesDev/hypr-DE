#!/bin/sh
ident=
while [ $# -gt 0 ]; do
    case "$1" in
        -t) ident=$2; shift 2 ;;
        -p) shift 2 ;;
        *) break ;;
    esac
done
[ "${LOCK_POLICY_JOURNAL_STATUS:-0}" -ne 0 ] && exit "$LOCK_POLICY_JOURNAL_STATUS"
if [ $# -eq 0 ]; then
    while IFS= read -r line; do
        printf '%s: %s\n' "$ident" "$line" >> "$LOCK_POLICY_JOURNAL"
    done
    exit 0
fi
printf '%s: exec %s\n' "$ident" "$*" >> "$LOCK_POLICY_JOURNAL"
exec "$@"
