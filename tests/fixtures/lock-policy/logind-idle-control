#!/bin/sh
# Stand-in for logind-idle-control. `status` answers from the environment
# (1 = the user's deliberate idle inhibitor is on) and is deliberately NOT
# logged: it is a query, and the effect log asserts effects. Everything
# else is logged so the lock paths that release the inhibitor stay visible.
case "${1:-}" in
    status)
        # A wedged daemon: hypridle runs condition_cmd synchronously with no
        # deadline of its own, so the script must impose one.
        [ "${LOCK_POLICY_INHIBIT_HANG:-0}" = 1 ] && sleep 30
        printf '%s\n' "${LOCK_POLICY_INHIBIT_ENABLED:-0}"
        exit 0 ;;
esac
# A wedged daemon on the release path: hypridle holds its sleep inhibitor
# until before_sleep_cmd returns, so an unbounded call here delays suspend.
[ "${LOCK_POLICY_INHIBIT_HANG:-0}" = 1 ] && sleep 30
printf 'logind-idle-control:%s\n' "$*" >> "$LOCK_POLICY_LOG"
exit "${LOCK_POLICY_INHIBIT_STATUS:-0}"
