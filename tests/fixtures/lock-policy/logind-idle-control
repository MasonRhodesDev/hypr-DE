#!/bin/sh
# Stand-in for logind-idle-control. `status` answers from the environment
# (1 = the user's deliberate idle inhibitor is on) and is deliberately NOT
# logged: it is a query, and the effect log asserts effects. Everything
# else is logged so the lock paths that release the inhibitor stay visible.
case "${1:-}" in
    status) printf '%s\n' "${LOCK_POLICY_INHIBIT_ENABLED:-0}"; exit 0 ;;
esac
printf 'logind-idle-control:%s\n' "$*" >> "$LOCK_POLICY_LOG"
exit "${LOCK_POLICY_INHIBIT_STATUS:-0}"
