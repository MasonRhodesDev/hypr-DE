#!/bin/sh
# Stand-in for loginctl: reports a controllable LockedHint and logs session
# termination so the fail-closed path is observable.
case "${1:-}" in
    show-session)
        # logind resolves `self` from the caller's cgroup. hypridle.service
        # (and everything it spawns) lives in app.slice, not session-N.scope,
        # so `self` fails there exactly like this -- only an explicit id or
        # `auto` resolves. Keep the fixture as strict as the real thing.
        case "${2:-}" in
            self)
                echo "Failed to get path for session 'self': Caller does not belong to any known session." >&2
                exit 1 ;;
        esac
        case "$*" in
            *LockedHint*) printf '%s\n' "${LOCK_POLICY_LOCKED_HINT:-no}" ;;
            *Id*)         printf '%s\n' "${LOCK_POLICY_SESSION_ID:-7}" ;;
        esac
        ;;
    terminate-session|terminate-user)
        printf 'loginctl:%s\n' "$*" >> "$LOCK_POLICY_LOG"
        ;;
esac
exit 0
