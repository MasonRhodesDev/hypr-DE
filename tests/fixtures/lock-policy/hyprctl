#!/bin/sh
# Stand-in for hyprctl: answers the compositor-lock query from the
# environment and logs every dispatch so effects are observable.
case "${1:-}" in
    locked)
        # A wedged compositor: the scripts run on hypridle's single
        # synchronous loop, so they must bound this too.
        [ "${LOCK_POLICY_COMPOSITOR_HANG:-0}" = 1 ] && sleep 30
        printf '%s\n' "${LOCK_POLICY_COMPOSITOR_LOCKED:-false}"
        exit 0 ;;
esac
printf 'hyprctl:%s\n' "$*" >> "$LOCK_POLICY_LOG"
