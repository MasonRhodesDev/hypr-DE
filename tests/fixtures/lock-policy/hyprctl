#!/bin/sh
case "${1:-}" in
    locked|getoption)
        [ -n "${LOCK_POLICY_HYPRCTL_SLOW:-}" ] && [ -e "$LOCK_POLICY_HYPRCTL_SLOW" ] && sleep 4 ;;
esac
case "${1:-}" in
    -j)
        if [ "${2:-}" = clients ]; then
            [ "${LOCK_POLICY_COMPOSITOR_HANG:-0}" = 1 ] && sleep 30
            if [ -n "${LOCK_POLICY_INHIBIT_CLIENT:-}" ]; then
                printf '[{"class":"%s","inhibitingIdle":true}]\n' "$LOCK_POLICY_INHIBIT_CLIENT"
            else
                printf '[]\n'
            fi
            exit 0
        fi ;;
    locked)
        [ "${LOCK_POLICY_COMPOSITOR_HANG:-0}" = 1 ] && sleep 30
        if [ -n "${LOCK_POLICY_LOCK_FILE:-}" ] && [ -e "$LOCK_POLICY_LOCK_FILE" ]; then
            echo true
        else
            printf '%s\n' "${LOCK_POLICY_COMPOSITOR_LOCKED:-false}"
        fi
        exit 0 ;;
    getoption)
        [ "${2:-}" = misc:allow_session_lock_restore ] || { echo "no such option"; exit 0; }
        printf 'bool: %s\nset: true\n' "${LOCK_POLICY_RESTORE:-false}"
        exit 0 ;;
esac
printf 'hyprctl:%s\n' "$*" >> "$LOCK_POLICY_LOG"
