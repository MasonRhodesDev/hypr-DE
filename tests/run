#!/bin/bash
set -uo pipefail
for fd in /proc/self/fd/*; do
    n=${fd##*/}
    case $n in 0|1|2|255) ;; *) eval "exec $n>&-" 2>/dev/null ;; esac
done
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname -- "$here")

reachable() {
    local p v
    for p in /run/systemd/private /run/dbus/system_bus_socket /var/run/dbus/system_bus_socket \
             /run/user/*/bus /run/user/*/wayland-* /run/user/*/hypr /tmp/.X11-unix/X*; do
        [ -e "$p" ] && { printf '%s\n' "$p"; return 0; }
    done
    for v in XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE; do
        [ -n "${!v-}" ] && { printf '$%s\n' "$v"; return 0; }
    done
    if grep -qE '@/tmp/(\.X11-unix|dbus-)' /proc/net/unix 2>/dev/null; then
        printf 'an abstract X11 or D-Bus socket\n'
        return 0
    fi
    return 1
}

sealed=1
if ! command -v bwrap >/dev/null 2>&1 || ! bwrap --unshare-all --ro-bind / / true 2>/dev/null; then
    if [ "${HYPR_DE_ALLOW_UNSEALED-}" != 1 ]; then
        echo "tests/run: bubblewrap cannot create a sandbox here; refusing to run tests" >&2
        exit 2
    fi
    if endpoint=$(reachable); then
        echo "tests/run: no sandbox and $endpoint is present; refusing to run tests" >&2
        exit 2
    fi
    echo "tests/run: no sandbox; running unsealed in a package build with no session or system bus" >&2
    sealed=0
fi

tripwired=(
    systemctl loginctl shutdown reboot poweroff halt systemd-run systemd-inhibit
    busctl dbus-send gdbus desktop-boot-exit hyprshutdown fuzzel hyprctl hypridle
    hyprlock swaylock vigil vigil-lock greetd hyprstate uwsm notify-send
    swaync-client playerctl wpctl pactl brightnessctl swaybg
)
declare -A wired=()
for name in "${tripwired[@]}"; do wired[$name]=1; done

wires=()
declare -A seen=()
if bwrap --help 2>&1 | grep -q -- --tmp-overlay; then
    wires+=(--overlay-src /usr/bin --tmp-overlay /usr/bin)
    for name in "${tripwired[@]}"; do
        [ -L "/usr/bin/$name" ] && continue
        seen[/usr/bin/$name]=1
        wires+=(--ro-bind "$here/tripwire" "/usr/bin/$name")
    done
fi
for name in "${tripwired[@]}"; do
    for dir in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -e "$dir/$name" ] || continue
        real=$(readlink -f -- "$dir/$name")
        [ -n "${wired[${real##*/}]-}" ] || continue
        [ -n "${seen[$real]-}" ] && continue
        seen[$real]=1
        wires+=(--ro-bind "$here/tripwire" "$real")
    done
done

system=()
for d in /usr /etc /opt /bin /sbin /lib /lib32 /lib64 /libx32; do
    if [ -L "$d" ]; then
        system+=(--symlink "$(readlink -- "$d")" "$d")
    elif [ -d "$d" ]; then
        system+=(--ro-bind "$d" "$d")
    fi
done

# a compiler the caller names, such as the safety gates' recording wrappers, builds the tests too
compilers=()
named=()
for var in CC CXX; do
    if [[ -n "${!var-}" ]]; then
        compilers+=(--setenv "$var" "${!var}")
        named+=("$var=${!var}")
    fi
done

log=$(mktemp -d) || exit 2
trap 'rm -rf "$log"' EXIT

sandbox() {
    bwrap --unshare-all --die-with-parent --new-session --cap-drop ALL \
        "${system[@]}" --dev /dev --proc /proc \
        --tmpfs /tmp --tmpfs /run --tmpfs /var --dir /tmp/home \
        --ro-bind "$root" "$root" \
        --bind "$log" /run/tripwire \
        "${wires[@]}" \
        --clearenv \
        --setenv PATH /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        --setenv HOME /tmp/home \
        --setenv LANG C.UTF-8 \
        --setenv TERM "${TERM:-dumb}" \
        --setenv PYTHONPYCACHEPREFIX /tmp/pycache \
        "${compilers[@]}" \
        --chdir "$root" \
        "$@"
}

if [ "$sealed" = 1 ] && [ "${#seen[@]}" -gt 0 ]; then
    canary=$(printf '%s\n' "${!seen[@]}" | head -n1)
    : >"$log/hits"
    sandbox "$canary" --canary >/dev/null 2>&1
    rc=$?
    if [ "$rc" -ne 97 ] || ! grep -q -- '--canary' "$log/hits"; then
        echo "tests/run: the tripwire on $canary did not fire; refusing to run tests" >&2
        exit 2
    fi
fi

if [ $# -eq 0 ]; then
    set -- "$here"/*.sh
fi

failed=0
for t in "$@"; do
    t=$(readlink -f -- "$t")
    name=${t#"$root"/}
    : >"$log/hits"
    if [ "$sealed" = 0 ]; then
        mkdir -p "$log/home"
        (cd "$root" && env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
            HOME="$log/home" LANG=C.UTF-8 TERM="${TERM:-dumb}" \
            PYTHONPYCACHEPREFIX="$log/pycache" HYPR_DE_SEALED=build-root "${named[@]}" "$t")
    else
        sandbox "$t"
    fi
    rc=$?
    if [ -s "$log/hits" ]; then
        printf 'TRIPWIRE %s reached real commands:\n' "$name"
        sed 's/^/    /' "$log/hits"
        failed=1
    elif [ "$rc" -ne 0 ]; then
        printf 'FAILED %s (exit %s)\n' "$name" "$rc"
        failed=1
    fi
done
exit "$failed"
