# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>
# Split package: hypr-de (the DE) + hypr-de-gaming (optional gaming layer).
# Runtime deps are generated from ../deps.toml — edit THAT file; CI
# (packaging/gen-deps.sh check) gates drift against these arrays.
pkgbase=hypr-de
pkgname=('hypr-de' 'hypr-de-gaming')
pkgver=0.2.24
pkgrel=1
pkgdesc="Alpha Hyprland config set (not ready)"
arch=('any')
url="https://github.com/MasonRhodesDev/hypr-DE"
license=('MIT')
makedepends=('file')
source=("$pkgbase-$pkgver.tar.gz::https://github.com/MasonRhodesDev/hypr-DE/archive/v$pkgver.tar.gz")
sha256sums=('402afa6bd546b287d1491ad6cd665ea17b6a19d9f0468602b60528d2323be65c')

_depends_main=(
  bluez bluez-obex bluez-utils brightnessctl fuzzel gnome-keyring
  gpu-screen-recorder grim gtk4 'hypridle>=0.1.8' 'hyprland>=0.56' hyprland-guiutils
  hyprland-qt-support hyprpicker hyprpolkitagent
  hyprpwcenter hyprshutdown 'hyprstate>=2.5.0' dials jq kitty libadwaita
  libnotify lmtt logind-idle-control man-db matugen nautilus network-manager-applet
  neovim networkmanager noto-fonts overskride papirus-icon-theme pavucontrol pipewire
  pipewire-alsa pipewire-pulse playerctl python python-dbus python-gobject
  qt6ct slurp sni-watcher socat swappy swaybg swaync ttf-firacode-nerd
  ttf-jetbrains-mono-nerd ttf-nerd-fonts-symbols udiskie uwsm 'vigil>=0.3.0' waybar
  'waybar-workspace-buttons>=1.1.2'
  wireplumber wl-clipboard xdg-desktop-portal xdg-desktop-portal-gtk
  xdg-desktop-portal-hyprland
)
_depends_gaming=(python)

build() {
  cd "$srcdir"; cd "hypr-DE-$pkgver" 2>/dev/null || cd "$pkgbase-$pkgver"  # GH tarball vs CI snapshot prefix
  cp -a dist dist-build
  LIBEXECDIR=/usr/lib/hypr-de \
  WAYBAR_CFFI=/usr/lib/waybar/workspace_buttons.so \
    ./packaging/substitute.sh dist-build
}

check() {
  cd "$srcdir"; cd "hypr-DE-$pkgver" 2>/dev/null || cd "$pkgbase-$pkgver"
  ./packaging/gen-deps.sh check
  ./packaging/check-units.sh
  ./tests/lock-policy.sh
  ./tests/installer-trust.sh
  ./tests/steam-launch-options.sh
  ./tests/runtime-paths.sh
  ./tests/pam-rewrite.sh
  ./tests/share-consent.sh
}

package_hypr-de() {
  depends=("${_depends_main[@]}")
  optdepends=(
    'satty: alternative screenshot annotation'
    'hyprsunset: blue-light filter; start from local.lua, not autostarted'
    'nvidia-utils: proprietary NVIDIA driver (optional; session detects the module)'
    'libva-nvidia-driver: NVIDIA VA-API when the nvidia module is loaded'
  )
  backup=('etc/xdg/uwsm/env'
          'etc/xdg/uwsm/env-hyprland'
          'etc/greetd/vigil.toml')
  install=hypr-de.install

  cd "$srcdir"; cd "hypr-DE-$pkgver" 2>/dev/null || cd "$pkgbase-$pkgver"  # GH tarball vs CI snapshot prefix
  LIBEXECDIR=/usr/lib/hypr-de \
    ./packaging/install.sh dist-build "$pkgdir" main
  # lmtt modules under the generic system module dir
  install -d "$pkgdir/usr/share/lmtt/modules"
  install -Dm644 dist-build/lmtt/modules/*.toml -t "$pkgdir/usr/share/lmtt/modules/"
  # pacman hook: reload live Hyprland sessions after the transaction so an
  # upgrade cannot leave a stale "config has errors" banner on screen.
  install -Dm644 dist-build/pacman/95-hypr-de-reload.hook \
    "$pkgdir/usr/share/libalpm/hooks/95-hypr-de-reload.hook"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hypr-de/LICENSE"
}

package_hypr-de-gaming() {
  pkgdesc="Gaming additions for hypr-DE (game workspace routing, Steam session hygiene)"
  depends=('hypr-de' "${_depends_gaming[@]}")
  optdepends=('steam' 'gamemode')

  cd "$srcdir"; cd "hypr-DE-$pkgver" 2>/dev/null || cd "$pkgbase-$pkgver"  # GH tarball vs CI snapshot prefix
  LIBEXECDIR=/usr/lib/hypr-de \
    ./packaging/install.sh dist-build "$pkgdir" gaming
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hypr-de-gaming/LICENSE"
}
