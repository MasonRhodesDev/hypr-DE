# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>
# Split package: hypr-de (the DE) + hypr-de-gaming (optional gaming layer).
# Runtime deps are generated from ../deps.toml — edit THAT file; CI
# (packaging/gen-deps.sh check) gates drift against these arrays.
pkgbase=hypr-de
pkgname=('hypr-de' 'hypr-de-gaming')
pkgver=0.1.0
pkgrel=1
pkgdesc="Opinionated Hyprland desktop environment"
arch=('any')
url="https://github.com/MasonRhodesDev/hypr-DE"
license=('MIT')
makedepends=('file')
source=("$pkgbase-$pkgver.tar.gz::https://github.com/MasonRhodesDev/hypr-DE/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

_depends_main=(
  brightnessctl fuzzel gpu-screen-recorder grim hypridle hyprland
  hyprland-voice-dictation hyprlock hyprpicker hyprpolkitagent hyprstate jq
  kitty libnotify lmtt logind-idle-control matugen network-manager-applet
  noto-fonts pavucontrol playerctl python python-dbus python-gobject slurp
  socat swappy swaybg swaync ttf-firacode-nerd ttf-jetbrains-mono-nerd
  udiskie uwsm waybar waybar-workspace-buttons wireplumber wl-clipboard
  xdg-desktop-portal-hyprland
)
_depends_gaming=(python)

build() {
  cd "hypr-DE-$pkgver"
  cp -a dist dist-build
  LIBEXECDIR=/usr/lib/hypr-de \
  WAYBAR_CFFI=/usr/lib/waybar/workspace_buttons.so \
    ./packaging/substitute.sh dist-build
}

package_hypr-de() {
  depends=("${_depends_main[@]}")
  optdepends=('satty: alternative screenshot annotation'
              'thunar: file manager bound to SUPER+E')
  install=hypr-de.install

  cd "hypr-DE-$pkgver"
  LIBEXECDIR=/usr/lib/hypr-de \
    ./packaging/install.sh dist-build "$pkgdir" main
  # lmtt modules under the generic system module dir
  install -d "$pkgdir/usr/share/lmtt/modules"
  install -Dm644 dist-build/lmtt/modules/*.toml -t "$pkgdir/usr/share/lmtt/modules/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hypr-de/LICENSE"
}

package_hypr-de-gaming() {
  pkgdesc="Gaming additions for hypr-DE (game workspace routing, Steam session hygiene)"
  depends=('hypr-de' "${_depends_gaming[@]}")
  optdepends=('steam' 'gamemode')

  cd "hypr-DE-$pkgver"
  LIBEXECDIR=/usr/lib/hypr-de \
    ./packaging/install.sh dist-build "$pkgdir" gaming
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hypr-de-gaming/LICENSE"
}
