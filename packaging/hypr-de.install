post_install() {
    /usr/lib/hypr-de/hypr-de-sys-setup || true
    cat <<'EOF'
==> hypr-DE installed. Per user, run:
      hypr-de-setup          # presets user units; seeds xdph.conf
    Log into Hyprland (uwsm-managed) at the vigil greeter.
    Overrides: ~/.config/hypr/local.lua, ~/.config/lmtt/modules/, systemd
    user drop-ins. See /usr/share/hypr-de/hypr/local.lua.example.
EOF
}

post_upgrade() {
    /usr/lib/hypr-de/hypr-de-sys-setup || true
}
